#!/usr/bin/env bash
# One entry point for the whole stack. Everything runs under docker compose;
# nginx puts it all on http://localhost, so there is nothing to start in a
# second terminal unless you specifically want Vite's hot reload.
set -euo pipefail
cd "$(dirname "$0")"

# APP-010: emg-service and hemo-backend-stage are profile-gated in
# docker-compose.yml -- they keep their config but do not start by default.
# They are OUT of APP_SERVICES, so `restart` with no argument cannot error on
# a service compose has not been told about.
APP_SERVICES=(backend frontend hemo-backend hemo-frontend nginx)

# ALL_PROFILES is for commands that must see every container that exists, not
# just the default set. `down` and `ps` need it: without the profiles, a `down`
# removes the 5 default services and leaves a gated one holding the network,
# which fails with "Resource is still in use". `up` deliberately does NOT use
# it -- not starting them is the point.
ALL_PROFILES=(--profile emg --profile stage)

usage() {
  cat <<'USAGE'
./dev <command>

  up               start everything (build if images are missing)
  down             stop everything, gated services included
  stage            start hemo-backend-stage (profile-gated, off by default)
  emg              start emg-service       (profile-gated, off by default)
  db-refresh       copy prod DB into this clone's *_test DB (APP-T7)
  verify           run the APP-0.1 test-environment gate (APP-T12)
  restart [svc]    restart a service, or all of them
  rebuild [svc]    rebuild image(s) and restart -- USE THIS after editing code
  logs [svc]       follow logs (all services, or one)
  ps               what is running, and which ports are published
  vite             run their Vite dev server with hot reload (optional)
  shell <svc>      open a shell inside a container
  test             run the backend + frontend test suites
  otp              print the most recent DEV OTP from the backend log
  health           show healthcheck status for all services
  stats            show CPU / memory usage per container

Code changes need `rebuild`, not `restart`: the images COPY the source in, so
a restart just runs the same baked code again.

`emg-service` and `hemo-backend-stage` do not start with `up` -- they are
profile-gated (APP-010). Start them with `./dev emg` / `./dev stage`. `down`
and `ps` include them; `up`, `restart` and `rebuild` do not.
USAGE
}

case "${1:-}" in
  up)      docker compose up -d --build; echo; echo "→ http://localhost"; docker compose ps --format '{{.Service}}\t{{.State}}\t{{.Ports}}' ;;
  down)    docker compose "${ALL_PROFILES[@]}" down ;;
  restart) shift; docker compose restart "${@:-${APP_SERVICES[@]}}" ;;
  rebuild)
    shift
    if [ $# -eq 0 ]; then docker compose up -d --build
    else docker compose build "$@" && docker compose up -d "$@"; fi
    docker compose ps --format '{{.Service}}\t{{.State}}' ;;
  logs)    shift; docker compose logs -f --tail=80 "$@" ;;
  ps)      docker compose "${ALL_PROFILES[@]}" ps --format '{{.Service}}\t{{.State}}\t{{.Ports}}' ;;
  stage)   docker compose --profile stage up -d hemo-backend-stage; echo '→ hemo-backend-stage on :5001' ;;
  emg)     docker compose --profile emg up -d emg-service; echo '→ emg-service (internal only, UDP 8888)' ;;
  db-refresh) shift; venv/bin/python scripts/db_refresh.py "$@" ;;
  verify)  ./scripts/verify_testenv.sh ;;
  vite)    cd part2/Hemophillia-confirm/frontend && npm run dev ;;
  shell)   shift; docker compose exec "${1:?service name required}" sh ;;
  test)
    ( cd backend && for f in app/test_events_mirror.py app/routes/test_session.py \
        app/routes/test_capabilities.py app/routes/test_report.py \
        app/routes/test_history.py app/ws/test_session_ws.py; do
        printf '%-28s ' "$(basename "$f")"; ../venv/bin/python "$f" 2>&1 | grep -vi warning | tail -1
      done )
    ( cd frontend && node --test 'tests/**/*.test.mjs' 2>&1 | grep -E 'ℹ (pass|fail)' ) ;;
  otp)     docker compose logs --tail=200 hemo-backend | grep "DEV OTP" | tail -3 ;;
  health)  docker compose ps --format '{{.Service}}\t{{.State}}\t{{.Health}}' ;;
  stats)   docker stats --no-stream --format 'table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.MemPerc}}' ;;
  *)       usage ;;
esac
